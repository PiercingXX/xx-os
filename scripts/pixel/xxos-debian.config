# Kernel options a Debian userland needs that the Pixel GKI leaves out.
# Applied as a defconfig fragment on both tracks (a no-op where mainline's
# zumapro_defconfig already has them). See docs/pixel-9-bringup.md 3.3.

# systemd's hard requirements (systemd README): devtmpfs and file handles.
# GKI has neither; Android's init mounts tmpfs on /dev and runs ueventd.
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_FHANDLE=y

# systemd's recommended options.
CONFIG_AUTOFS_FS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y

# User namespaces, for bubblewrap and Flatpak later.
CONFIG_USER_NS=y

# Usermode helpers: GKI routes them through a static (empty) path, which
# breaks core_pattern pipes such as systemd-coredump.
# CONFIG_STATIC_USERMODEHELPER is not set

# A picture without serial: the bootloader's splash framebuffer through
# simpledrm, and the kernel console on it.
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y

# Read our own config back on the phone.
CONFIG_IKCONFIG_PROC=y
