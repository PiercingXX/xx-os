#!/bin/sh
# Session launcher: starts the phoc compositor with the XX-WM shell as the client.
# Reads ~/.config/xx-wm/config.json to propagate theme preference to GTK.

_prefer_dark=$(python3 -c "
import json, sys
try:
    cfg = json.load(open('$HOME/.config/xx-wm/config.json'))
    print('1' if cfg.get('prefer_dark', True) else '0')
except Exception:
    print('1')
" 2>/dev/null || echo '1')

if [ "$_prefer_dark" = "1" ]; then
    export ADWAITA_COLOR_SCHEME=prefer-dark
    # GTK3 clients (squeekboard) need a real GTK3 theme name — 'Adw-dark'
    # does not exist for them and silently falls back to light Adwaita
    export GTK_THEME=Adwaita:dark
else
    export ADWAITA_COLOR_SCHEME=prefer-light
    export GTK_THEME=Adwaita
fi

# Qt apps follow the GTK theme only when a gtk3 platformtheme plugin exists
# (Qt5's libqgtk3; Qt6 ships no GTK platform theme, so probe both trees).
for _qt_plugin in \
    /usr/lib/qt/plugins/platformthemes/libqgtk3.so \
    /usr/lib64/qt/plugins/platformthemes/libqgtk3.so \
    /usr/lib/qt6/plugins/platformthemes/libqgtk3.so \
    /usr/lib64/qt6/plugins/platformthemes/libqgtk3.so; do
    if [ -e "$_qt_plugin" ]; then
        QT_QPA_PLATFORMTHEME=gtk3
        export QT_QPA_PLATFORMTHEME
        break
    fi
done
unset _qt_plugin

# Marks the real session — enables session-only behavior (app preloading)
export XX_WM_SESSION=1

# GTK 4 tries Vulkan before GL. On Halium phones (libhybris; the FLX1)
# the Vulkan driver loads but has no Wayland surface support: every GTK
# process (the shell and each app) loads it, logs vkCreateWaylandSurfaceKHR
# VK_ERROR_EXTENSION_NOT_PRESENT and only then falls back to GL. Ask for
# GL up front there. Mainline devices keep GTK's own choice, and a
# GSK_RENDERER already set (greetd, ~/.profile) always wins.
_xx_libhybris() {
    for _xx_lib in "${XX_WM_LIB_ROOT:-}"/usr/lib/libhybris-common.so* \
                   "${XX_WM_LIB_ROOT:-}"/usr/lib/*/libhybris-common.so*; do
        [ -e "$_xx_lib" ] && return 0
    done
    return 1
}
if [ -z "${GSK_RENDERER:-}" ] && _xx_libhybris; then
    GSK_RENDERER=ngl
    export GSK_RENDERER
fi

# Desktop/session identity for portals and D-Bus activation: greetd and
# bare `phoc` launches may not set these, and xdg-desktop-portal picks
# xx-wm-portals.conf by the lowercased XDG_CURRENT_DESKTOP.
: "${XDG_CURRENT_DESKTOP:=XX-WM}"
: "${XDG_SESSION_TYPE:=wayland}"
export XDG_CURRENT_DESKTOP XDG_SESSION_TYPE

# Phone behavior: every app opens maximized (full-screen), never floating.
# phoc reads this from the sm.puri.phoc GSetting (not phoc.ini) — set it
# before phoc starts. Persists in dconf, so this is idempotent.
if command -v gsettings >/dev/null 2>&1 && \
   gsettings list-schemas 2>/dev/null | grep -q '^sm\.puri\.phoc$'; then
    gsettings set sm.puri.phoc auto-maximize true 2>/dev/null || true
fi

# Keyboard layout from the `keyboard_layout` config key (default us,
# Settings → Keyboard). The hardware keymap must stay a real xkb layout:
# piercing-num is OSK-only, so it maps to us here — same rule as
# launcher/src/keyboard_layouts.py::xkb_for (duplicated: the shell is not
# importable this early). mru-sources often stays [('xkb','us')] after a
# piercing-shell migrate; pin both keys every session.
_keyboard_layout=$(python3 -c "
import json, re, sys
try:
    cfg = json.load(open('$HOME/.config/xx-wm/config.json'))
    layout = str(cfg.get('keyboard_layout', 'us'))
except Exception:
    layout = 'us'
layout = layout.strip().lower()
if not re.match(r'^[a-z][a-z0-9-]{1,23}(\+[a-z0-9_-]{1,32})?$', layout):
    layout = 'us'
if layout == 'piercing-num':
    layout = 'us'
print(layout)
" 2>/dev/null || echo 'us')

if command -v gsettings >/dev/null 2>&1 && \
   gsettings list-schemas 2>/dev/null | grep -q '^org\.gnome\.desktop\.input-sources$'; then
    gsettings set org.gnome.desktop.input-sources sources "[('xkb', '$_keyboard_layout')]" 2>/dev/null || true
    gsettings set org.gnome.desktop.input-sources mru-sources "[('xkb', '$_keyboard_layout')]" 2>/dev/null || true
fi

# phoc shell mode (-S): phoc covers every output and drops input until
# the shell reports UP over phosh_private (wayland_bindings.py) — sent only
# once the lock screen is mapped when a PIN is set, so a shell crash or
# restart never exposes unlocked apps. Only with a phoc that has the flag
# and a pywayland able to generate the bindings (otherwise nothing could
# ever lower the shield); XX_WM_PHOC_SHELL_MODE=0 opts out.
_phoc_shell_flag=
if [ "${XX_WM_PHOC_SHELL_MODE:-1}" != "0" ] && \
   phoc --help 2>&1 | grep -q -- '--shell' && \
   python3 -c 'import pywayland.scanner' >/dev/null 2>&1; then
    _phoc_shell_flag=-S
    XX_WM_PHOC_SHELL_MODE=1
else
    XX_WM_PHOC_SHELL_MODE=0
fi
export XX_WM_PHOC_SHELL_MODE

# shellcheck disable=SC2086 # empty flag must vanish, not become ''
exec phoc $_phoc_shell_flag \
  -C @datadir@/xx-wm/phoc.ini \
  -E "@bindir@/xx-wm"
