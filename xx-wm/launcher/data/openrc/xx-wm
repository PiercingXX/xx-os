#!/sbin/openrc-run
# XX-WM shell session started straight from OpenRC: a last resort for
# hosts without tinydm or greetd. It runs the session without a PAM
# login, so elogind registers no session for it and polkit refuses the
# privileged helper's actions (docs/helper.md, "Sessions and polkit").
# scripts/install.sh prefers tinydm or greetd.

name="xx-wm"
description="XX-WM shell session"

: "${XX_WM_USER:=user}"

command="@libexecdir@/xx-wm-session"
command_user="${XX_WM_USER}"
command_background=false
supervisor=supervise-daemon
respawn_delay=2
# The wrapper respawns a crashing shell itself; a crash loop at startup
# hands the session to Phosh when it is installed, and otherwise exits
# non-zero: retry that a few times, then stop.
respawn_max=3
respawn_period=600
output_log="/var/log/xx-wm.log"
error_log="/var/log/xx-wm.log"

depend() {
    need localmount
    after bootmisc
    want elogind
}

start_pre() {
    # Never fall back to root: a missing user would otherwise run the
    # whole session as root.
    if ! _uid=$(id -u "${XX_WM_USER}" 2>/dev/null) || [ "$_uid" = 0 ]; then
        eerror "XX_WM_USER='${XX_WM_USER}' is not a regular user; set it in /etc/conf.d/xx-wm"
        return 1
    fi
    ewarn "Starting XX-WM without a login session: privileged Settings actions will be refused (use tinydm or greetd)"
    checkpath -f -o "${XX_WM_USER}" "$output_log"
    # Without an active logind session nothing creates the per-user
    # runtime dir: make it here so the shell (and its IPC socket) lands
    # in the same place it does under systemd.
    _rdir="/run/user/${_uid}"
    mkdir -p "$_rdir" 2>/dev/null || true
    chown "${_uid}" "$_rdir" 2>/dev/null || true
    chmod 700 "$_rdir" 2>/dev/null || true
    export XDG_RUNTIME_DIR="$_rdir"
}
